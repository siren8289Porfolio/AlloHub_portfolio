# AlloHub EC2 / Docker Compose (.env)
# EC2: /home/ubuntu/allohub/.env

# PostgreSQL
DB_NAME=allohub
DB_USER=allochub
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Spring Boot
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Auth tokens (Bearer)
ALLOC_OPERATOR_TOKEN=operator-dev-token
ALLOC_ADMIN_TOKEN=admin-dev-token

# FastAPI AI Service (Evidence / explain). Ledger stays on Spring.
ALLOC_AI_ENABLED=true
ALLOC_AI_BASE_URL=http://allohub-ai:8000
ALLOC_AI_CONNECT_TIMEOUT_MS=1000
ALLOC_AI_READ_TIMEOUT_MS=3000
AI_OPENDART_API_KEY=
AI_LLM_ENABLED=false

# Front (nginx /allohub 경로)
NEXT_PUBLIC_BASE_PATH=/allohub
NEXT_PUBLIC_API_BASE=/allohub/api
BACKEND_URL=http://allohub-app:8080
